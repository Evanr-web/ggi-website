---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import Gallery from '../../components/Gallery.astro';
import VideoSection from '../../components/VideoSection.astro';
import { getLibraryArticle, getLibraryArticles, imageUrl as sanityImageUrl } from '../../lib/sanity';
import { toHTML } from '@portabletext/to-html';

export async function getStaticPaths() {
  const articles = await getLibraryArticles();

  return (articles || [])
    .filter((a: any) => a.slug?.current)
    .map((a: any) => ({
      params: { slug: a.slug.current },
    }));
}

const { slug } = Astro.params;
const article = await getLibraryArticle(slug as string);

if (!article) {
  return Astro.redirect('/404');
}

const base = import.meta.env.BASE_URL;

// Format date
const pubDate = article.publishDate ? new Date(article.publishDate) : null;
const months = ['January','February','March','April','May','June','July','August','September','October','November','December'];
const dateStr = pubDate ? `${months[pubDate.getMonth()]} ${pubDate.getDate()}, ${pubDate.getFullYear()}` : '';

// Get author name — could be a reference or inline
const authorName = article.authorName || (typeof article.author === 'string' ? article.author : 'Gregory the Great Institute');
const authorPhoto = article.authorImage || '';

// Get image URL (with hotspot/crop support)
const articleImageUrl = sanityImageUrl(article.image, 1200) || article.featuredImage?.asset?.url || '';

// Category
const category = article.category || 'News';

// Render body from Portable Text
const bodyHtml = article.body ? toHTML(article.body, {
  components: {
    types: {
      image: ({value}: any) => {
        let url = '';
        if (value?.asset) {
          try {
            url = sanityImageUrl(value, value?.size === 'small' ? 300 : value?.size === 'medium' ? 600 : 1200) || value.asset?.url || '';
          } catch {
            url = value.asset?.url || '';
          }
        } else {
          url = value?.url || '';
        }
        const alt = value?.alt || '';
        const size = value.size || 'full';
        const float = value.float || 'none';
        const cls = `article__figure article__figure--${size}` + (float !== 'none' ? ` article__figure--${float}` : '');
        const caption = alt ? `<figcaption style="text-align:center;font-size:0.85rem;color:var(--color-gray,#666);margin-top:8px;">${alt}</figcaption>` : '';
        return `<figure class="${cls}"><img src="${url}" alt="${alt}" class="article__inline-img" loading="lazy" />${caption}</figure>`;
      },
      bodyImage: ({value}: any) => {
        const img = value?.image;
        let url = '';
        if (img?.asset) {
          try {
            url = sanityImageUrl(img, value?.size === 'small' ? 300 : value?.size === 'medium' ? 600 : 1200) || img.asset?.url || '';
          } catch {
            url = img.asset?.url || '';
          }
        }
        const alt = value?.alt || '';
        const size = value?.size || 'full';
        const float = value?.float || 'none';
        const cls = `article__figure article__figure--${size}` + (float !== 'none' ? ` article__figure--${float}` : '');
        const caption = alt ? `<figcaption style="text-align:center;font-size:0.85rem;color:var(--color-gray,#666);margin-top:8px;">${alt}</figcaption>` : '';
        return `<figure class="${cls}"><img src="${url}" alt="${alt}" class="article__inline-img" loading="lazy" />${caption}</figure>`;
      },
      inlineVideo: ({value}: any) => {
        const title = value?.title || '';
        const caption = title ? `<figcaption style="text-align:center;font-size:0.85rem;color:var(--color-gray,#666);margin-top:8px;">${title}</figcaption>` : '';
        if (value?.source === 'youtube' && value?.youtubeUrl) {
          const match = value.youtubeUrl.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/embed\/)([a-zA-Z0-9_-]{11})/);
          const ytId = match ? match[1] : null;
          if (ytId) {
            return `<figure class="article__video-embed"><div class="article__video-wrapper"><iframe src="https://www.youtube-nocookie.com/embed/${ytId}?rel=0" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen loading="lazy"></iframe></div>${caption}</figure>`;
          }
        }
        if (value?.fileUrl) {
          return `<figure class="article__video-embed"><video controls playsinline preload="metadata" style="width:100%;border-radius:3px;"><source src="${value.fileUrl}" /></video>${caption}</figure>`;
        }
        return '';
      },
    },
    block: {
      blockquote: ({children}: any) => `<blockquote class="article__pullquote"><p>${children}</p></blockquote>`,
      h2: ({children}: any) => `<h2>${children}</h2>`,
      h3: ({children}: any) => `<h3>${children}</h3>`,
    },
  },
}) : '';

// Estimate read time
const wordCount = article.body?.reduce((acc: number, block: any) => {
  if (block._type === 'block' && block.children) {
    return acc + block.children.reduce((a: number, c: any) => a + (c.text?.split(/\s+/).length || 0), 0);
  }
  return acc;
}, 0) || 0;
const readTime = `${Math.max(1, Math.ceil(wordCount / 250))} min read`;
const videoPosition = article.videoPosition || 'bottom';
const hasVideos = article.videos && article.videos.length > 0;
const videoBlock = hasVideos ? article.videos.map((v: any) => ({
  title: v.title || 'Untitled',
  description: v.description || '',
  source: v.source || 'upload',
  fileUrl: v.fileUrl || '',
  youtubeUrl: v.youtubeUrl || '',
  thumbnailUrl: v.thumbnailUrl || '',
})) : [];
---

<ArticleLayout
  title={article.title}
  description={article.excerpt || ''}
  author={authorName}
  date={dateStr}
  category={category}
  readTime={readTime}
  image={articleImageUrl}
  imageAlt={article.title}
  authorImage={authorPhoto || undefined}
>
  {videoPosition === 'top' && hasVideos && (
    <VideoSection videos={videoBlock} />
  )}
  <Fragment set:html={bodyHtml} />
  {(article.gallery && article.gallery.length > 0) && (
    <Gallery photos={article.gallery.map((p: any) => ({
      url: sanityImageUrl(p, 1600) || p.url || '',
      thumbUrl: sanityImageUrl(p, 360, 270) || '',
      caption: p.caption || '',
      alt: p.alt || p.caption || '',
    }))} />
  )}
  {videoPosition === 'bottom' && hasVideos && (
    <VideoSection videos={videoBlock} />
  )}
  {article.downloadFile?.asset?.url && (
    <div class="article__download">
      <a href={article.downloadFile.asset.url} download class="article__download-btn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        Download Resource
      </a>
    </div>
  )}
</ArticleLayout>

<style>
  .article__download {
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid rgba(90, 90, 110, 0.1);
    text-align: center;
  }
  .article__download-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 600;
    padding: 14px 32px;
    background-color: var(--color-crimson);
    color: var(--color-parchment);
    border-radius: 3px;
    text-decoration: none;
    transition: background-color var(--transition-fast);
  }
  .article__download-btn:hover {
    background-color: #6b2124;
  }
</style>
