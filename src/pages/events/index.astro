---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventCard from '../../components/EventCard.astro';
import { getEvents, imageUrl, getSupporterEvenings } from '../../lib/sanity';

const base = import.meta.env.BASE_URL;

// Supporter Evenings banner
let seCms: any = null;
try { seCms = await getSupporterEvenings(); } catch (e) { /* fallback */ }
const showSeBanner = seCms?.enabled !== false; // show by default if no Sanity doc yet

// Try Sanity first
let sanityEvents: any[] = [];
try { sanityEvents = await getEvents() || []; } catch (e) { /* fallback */ }

// Map Sanity events to our format (skip events with no date)
const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
const events = sanityEvents
  .filter((e: any) => e.startDate) // skip events without dates
  .map((e: any) => {
    // Parse full ISO datetime; pin to Mountain Time so dates are correct on
    // any build server (Cloudflare runs UTC, local Mac runs MDT).
    const d = e.startDate.includes('T') ? new Date(e.startDate) : new Date(e.startDate + 'T12:00:00');
    const tz = 'America/Edmonton';
    const mtMonth = Number(d.toLocaleDateString('en-CA', { month: 'numeric', timeZone: tz })) - 1;
    const mtDay = d.toLocaleDateString('en-CA', { day: 'numeric', timeZone: tz });
    const mtYear = d.toLocaleDateString('en-CA', { year: 'numeric', timeZone: tz });
    const dateOnly = d.toLocaleDateString('en-CA', { year: 'numeric', month: '2-digit', day: '2-digit', timeZone: tz });
    return {
      title: e.title,
      month: months[mtMonth],
      day: mtDay,
      year: mtYear,
      date: dateOnly,
      location: e.location || '',
      description: e.shortDescription || '',
      href: `${base}events/${e.slug?.current}/`,
      programTag: e.programTag || (e.template ? e.template.charAt(0).toUpperCase() + e.template.slice(1) : ''),
      thumbnail: imageUrl(e.thumbnailImage || e.headerImage, 400, 400) || '',
      thumbnailAlt: e.title,
    };
  });

// Auto-split based on today's date
const today = new Date().toISOString().split('T')[0]; // YYYY-MM-DD
const thirtyDaysAgo = new Date(Date.now() - 30 * 24 * 60 * 60 * 1000).toISOString().split('T')[0];

const upcoming = events.filter(e => e.date >= today).sort((a, b) => a.date.localeCompare(b.date));
const recentPast = events.filter(e => e.date < today && e.date >= thirtyDaysAgo).sort((a, b) => b.date.localeCompare(a.date));
const olderPast = events.filter(e => e.date < thirtyDaysAgo).sort((a, b) => b.date.localeCompare(a.date));
const hasArchive = olderPast.length > 0;
---

<BaseLayout title="Events" description="Upcoming conferences, courses, book studies, and community gatherings across Canada.">

  <!-- Hero -->
  <section class="hero-compact section--dark">
    <div class="container" style="text-align: center; padding-block: 60px;">
      <h1 data-pagefind-weight="10" class="display" style="color: var(--color-text-on-dark);">Events</h1>
      <p style="font-family: var(--font-body); font-size: 1.05rem; color: rgba(245,239,229,0.8); max-width: 600px; margin-inline: auto; margin-top: 12px; line-height: 1.7;">
        Join us across Canada for conferences, courses, book studies, and community gatherings.
      </p>
    </div>
  </section>

  <!-- Supporter Evenings Banner -->
  {showSeBanner && (
  <section class="section" style="padding-block: 0;">
    <div class="container">
      <a href={`${base}events/supporter-evenings/`} class="se-banner">
        <div class="se-banner__img-wrap">
          <img src={`${base}images/events/supper-at-emmaus-caravaggio.jpg`} alt="Supper at Emmaus by Caravaggio" class="se-banner__img" loading="lazy" />
        </div>
        <div class="se-banner__content">
          <span class="se-banner__label">2026–2027 Season</span>
          <h3 class="se-banner__title">Supporter Evenings</h3>
          <p class="se-banner__desc">An evening with Dr. Ryan Topping to learn about the Institute's mission, share in its vision, and explore how you can help bring it forward.</p>
          <span class="se-banner__cta">Learn More & Register →</span>
        </div>
      </a>
    </div>
  </section>
  )}

  {upcoming.length > 0 && (
    <section class="section">
      <div class="container">
        <h2 style="margin-bottom: 24px;">Upcoming</h2>
        <div class="events-list">
          {upcoming.map(e => (
            <EventCard
              title={e.title}
              month={e.month}
              day={e.day}
              year={e.year}
              date={e.date}
              location={e.location}
              description={e.description}
              href={e.href}
              programTag={e.programTag}
              thumbnail={e.thumbnail}
              thumbnailAlt={e.thumbnailAlt}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  {recentPast.length > 0 && (
    <section class="section section--linen">
      <div class="container">
        <h2 style="margin-bottom: 24px;">Recent Events</h2>
        <div class="events-list events-list--past">
          {recentPast.map(e => (
            <EventCard
              title={e.title}
              month={e.month}
              day={e.day}
              year={e.year}
              date={e.date}
              location={e.location}
              description={e.description}
              href={e.href}
              programTag={e.programTag}
              thumbnail={e.thumbnail}
              thumbnailAlt={e.thumbnailAlt}
              past={true}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  {hasArchive && (
    <section class="section" style="padding-block: 32px;">
      <div class="container" style="text-align: center;">
        <a href={`${base}events/archive/`} class="archive-link">
          View Event Archive ({olderPast.length} past event{olderPast.length !== 1 ? 's' : ''}) →
        </a>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .events-list {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .events-list--past :global(.event-card) {
    opacity: 0.7;
  }

  .events-list--past :global(.event-card:hover) {
    opacity: 1;
  }

  .archive-link {
    font-family: var(--font-ui);
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-gold);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .archive-link:hover {
    color: var(--color-crimson);
  }

  /* ── Supporter Evenings Banner ── */
  .se-banner {
    display: grid;
    grid-template-columns: 320px 1fr;
    background: var(--color-navy);
    border-radius: 3px;
    overflow: hidden;
    text-decoration: none;
    margin-top: var(--space-section);
    transition: box-shadow var(--transition-base);
  }

  .se-banner:hover {
    box-shadow: 0 8px 32px rgba(14, 51, 82, 0.2);
  }

  .se-banner__img-wrap {
    position: relative;
    overflow: hidden;
    min-height: 200px;
  }

  .se-banner__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    display: block;
  }

  .se-banner__content {
    padding: 32px 36px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .se-banner__label {
    font-family: var(--font-ui);
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-gold);
    margin-bottom: 8px;
  }

  .se-banner__title {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--color-text-on-dark);
    margin-bottom: 10px;
  }

  .se-banner__desc {
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.6;
    color: rgba(245, 239, 229, 0.7);
    margin-bottom: 16px;
  }

  .se-banner__cta {
    font-family: var(--font-ui);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-gold);
    transition: color var(--transition-fast);
  }

  .se-banner:hover .se-banner__cta {
    color: var(--color-parchment);
  }

  @media (max-width: 768px) {
    .se-banner {
      grid-template-columns: 1fr;
    }

    .se-banner__img-wrap {
      max-height: 180px;
    }

    .se-banner__content {
      padding: 24px 20px;
    }
  }
</style>
