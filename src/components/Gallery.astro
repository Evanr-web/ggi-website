---
/**
 * Gallery — Photo filmstrip with lightbox
 * Usage: <Gallery photos={photos} />
 * Each photo: { url, caption?, alt? }
 */
interface GalleryPhoto {
  url: string;
  caption?: string;
  alt?: string;
}

interface Props {
  photos: GalleryPhoto[];
}

const { photos = [] } = Astro.props;
if (photos.length === 0) return null;
---

<section class="gallery" data-gallery>
  <h2 class="gallery__title">Photo Gallery</h2>
  <p class="gallery__subtitle">Click any photo to view full size · {photos.length} photos</p>

  <div class="gallery__filmstrip">
    {photos.map((photo, i) => (
      <button
        class="gallery__thumb"
        data-gallery-open={i}
        aria-label={photo.alt || photo.caption || `Photo ${i + 1}`}
        type="button"
      >
        <img
          src={photo.url}
          alt={photo.alt || photo.caption || ''}
          loading="lazy"
          class="gallery__thumb-img"
        />
      </button>
    ))}
  </div>
</section>

<!-- Lightbox -->
<div class="gallery-lightbox" id="gallery-lightbox" aria-hidden="true" role="dialog" aria-label="Photo viewer">
  <button class="gallery-lightbox__close" aria-label="Close" id="gallery-lb-close">&times;</button>
  <button class="gallery-lightbox__nav gallery-lightbox__prev" aria-label="Previous photo" id="gallery-lb-prev">&lsaquo;</button>
  <button class="gallery-lightbox__nav gallery-lightbox__next" aria-label="Next photo" id="gallery-lb-next">&rsaquo;</button>
  <div class="gallery-lightbox__content">
    <img class="gallery-lightbox__img" id="gallery-lb-img" src="" alt="" />
  </div>
  <div class="gallery-lightbox__footer">
    <p class="gallery-lightbox__caption" id="gallery-lb-caption"></p>
    <p class="gallery-lightbox__counter" id="gallery-lb-counter"></p>
  </div>
</div>

<style>
  /* === Gallery Section === */
  .gallery {
    margin-top: var(--space-component, 40px);
    padding-top: 28px;
    border-top: 1px solid rgba(90, 90, 110, 0.1);
  }

  .gallery__title {
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: var(--color-navy);
    font-weight: 700;
    margin-bottom: 4px;
  }

  .gallery__subtitle {
    font-family: var(--font-ui);
    font-size: 0.8rem;
    color: var(--color-gray);
    margin-bottom: 16px;
  }

  /* === Filmstrip === */
  .gallery__filmstrip {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    padding-bottom: 10px;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
  }

  .gallery__filmstrip::-webkit-scrollbar {
    height: 5px;
  }
  .gallery__filmstrip::-webkit-scrollbar-track {
    background: rgba(90, 90, 110, 0.08);
    border-radius: 3px;
  }
  .gallery__filmstrip::-webkit-scrollbar-thumb {
    background: var(--color-gold);
    border-radius: 3px;
  }

  .gallery__thumb {
    flex: 0 0 auto;
    width: 180px;
    height: 135px;
    border-radius: 3px;
    overflow: hidden;
    cursor: pointer;
    scroll-snap-align: start;
    border: 2px solid transparent;
    padding: 0;
    background: none;
    transition: transform 150ms ease, border-color 150ms ease, box-shadow 150ms ease;
  }

  .gallery__thumb:hover,
  .gallery__thumb:focus-visible {
    transform: translateY(-2px);
    border-color: var(--color-gold);
    box-shadow: 0 4px 12px rgba(14, 51, 82, 0.15);
  }

  .gallery__thumb:focus-visible {
    outline: 2px solid var(--color-gold);
    outline-offset: 2px;
  }

  .gallery__thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* === Lightbox === */
  .gallery-lightbox {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.93);
    z-index: 9999;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .gallery-lightbox[aria-hidden="false"] {
    display: flex;
  }

  .gallery-lightbox__close {
    position: absolute;
    top: 16px;
    right: 20px;
    background: none;
    border: none;
    color: rgba(255, 255, 255, 0.7);
    font-size: 2.2rem;
    cursor: pointer;
    padding: 8px;
    line-height: 1;
    transition: color 150ms ease;
    z-index: 2;
  }
  .gallery-lightbox__close:hover { color: white; }

  .gallery-lightbox__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: rgba(255, 255, 255, 0.5);
    font-size: 3rem;
    cursor: pointer;
    padding: 16px;
    line-height: 1;
    transition: color 150ms ease;
    user-select: none;
    z-index: 2;
  }
  .gallery-lightbox__nav:hover { color: white; }
  .gallery-lightbox__prev { left: 8px; }
  .gallery-lightbox__next { right: 8px; }

  .gallery-lightbox__content {
    max-width: 88vw;
    max-height: 75vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .gallery-lightbox__img {
    max-width: 100%;
    max-height: 75vh;
    object-fit: contain;
    border-radius: 3px;
  }

  .gallery-lightbox__footer {
    text-align: center;
    margin-top: 12px;
  }

  .gallery-lightbox__caption {
    font-family: var(--font-body);
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.9rem;
    font-style: italic;
  }

  .gallery-lightbox__counter {
    font-family: var(--font-ui);
    color: rgba(255, 255, 255, 0.4);
    font-size: 0.75rem;
    margin-top: 4px;
  }

  @media (max-width: 768px) {
    .gallery__thumb {
      width: 140px;
      height: 105px;
    }
    .gallery-lightbox__nav { font-size: 2rem; padding: 12px; }
  }
</style>

<script is:inline>
  (function() {
    var photos = [];
    var thumbs = document.querySelectorAll('[data-gallery-open]');
    var lb = document.getElementById('gallery-lightbox');
    if (!lb || thumbs.length === 0) return;

    // Build photo data from thumbs
    thumbs.forEach(function(thumb) {
      var img = thumb.querySelector('img');
      photos.push({
        url: img ? img.src : '',
        alt: img ? img.alt : '',
        caption: img ? img.alt : ''
      });
    });

    var current = 0;
    var lbImg = document.getElementById('gallery-lb-img');
    var lbCaption = document.getElementById('gallery-lb-caption');
    var lbCounter = document.getElementById('gallery-lb-counter');

    function show(index) {
      current = ((index % photos.length) + photos.length) % photos.length;
      var p = photos[current];
      lbImg.src = p.url;
      lbImg.alt = p.alt || '';
      lbCaption.textContent = p.caption || '';
      lbCounter.textContent = (current + 1) + ' / ' + photos.length;
      lb.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function hide() {
      lb.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    thumbs.forEach(function(thumb) {
      thumb.addEventListener('click', function() {
        show(parseInt(thumb.getAttribute('data-gallery-open'), 10));
      });
    });

    document.getElementById('gallery-lb-close').addEventListener('click', hide);
    document.getElementById('gallery-lb-prev').addEventListener('click', function(e) {
      e.stopPropagation(); show(current - 1);
    });
    document.getElementById('gallery-lb-next').addEventListener('click', function(e) {
      e.stopPropagation(); show(current + 1);
    });

    lb.addEventListener('click', function(e) {
      if (e.target === lb) hide();
    });

    document.addEventListener('keydown', function(e) {
      if (lb.getAttribute('aria-hidden') !== 'false') return;
      if (e.key === 'Escape') hide();
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });

    // Touch swipe support
    var startX = 0;
    lb.addEventListener('touchstart', function(e) {
      startX = e.changedTouches[0].screenX;
    }, { passive: true });
    lb.addEventListener('touchend', function(e) {
      var diff = e.changedTouches[0].screenX - startX;
      if (Math.abs(diff) > 50) {
        if (diff > 0) show(current - 1);
        else show(current + 1);
      }
    }, { passive: true });
  })();
</script>
